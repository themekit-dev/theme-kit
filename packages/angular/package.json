{
  "name": "@theme-kit/angular",
  "license": "MIT",
  "version": "1.0.1",
  "description": "Angular integration for Theme Kit",
  "type": "module",
  "scripts": {
    "build": "ng-packagr -p ng-package.json",
    "build:watch": "ng-packagr -p ng-package.json --watch",
    "test": "vitest"
  },
  "peerDependencies": {
    "@angular/core": ">=17.0.0",
    "@angular/common": ">=17.0.0"
  },
  "dependencies": {
    "@theme-kit/core": "workspace:*",
    "@theme-kit/web": "workspace:*",
    "@theme-kit/shadcn": "workspace:*",
    "@theme-kit/bootstrap": "workspace:*",
    "@theme-kit/daisyui": "workspace:*",
    "@theme-kit/open-props": "workspace:*",
    "tslib": "^2.8.0"
  },
  "devDependencies": {
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/compiler-cli": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "@types/node": "^26.1.1",
    "ng-packagr": "^22.0.0",
    "typescript": "~6.0.0",
    "vitest": "^4.1.10"
  },
  "main": "./dist/fesm2022/theme-kit-angular.mjs",
  "module": "./dist/fesm2022/theme-kit-angular.mjs",
  "types": "./dist/types/theme-kit-angular.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/theme-kit-angular.d.ts",
      "esm": "./dist/fesm2022/theme-kit-angular.mjs",
      "default": "./dist/fesm2022/theme-kit-angular.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/themekit-dev/theme-kit.git"
  },
  "homepage": "https://theme-kit-dev.vercel.app",
  "bugs": {
    "url": "https://github.com/themekit-dev/theme-kit/issues"
  },
  "keywords": [
    "theme",
    "angular",
    "theming",
    "dark-mode"
  ],
  "publishConfig": {
    "access": "public"
  }
}
