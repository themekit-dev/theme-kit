{
  "name": "@theme-kit/web",
  "license": "MIT",
  "version": "1.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@theme-kit/core": "workspace:*"
  },
  "description": "Vanilla JS theme runtime and DOM bindings for Theme Kit.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thememk/theme-kit.git"
  },
  "homepage": "https://theme-kit-docs.vercel.app",
  "bugs": {
    "url": "https://github.com/thememk/theme-kit/issues"
  },
  "keywords": [
    "theme",
    "theming",
    "vanilla-js",
    "dark-mode",
    "css-variables"
  ],
  "publishConfig": {
    "access": "public"
  }
}
