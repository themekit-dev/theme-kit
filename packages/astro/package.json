{
  "name": "@theme-kit/astro",
  "license": "MIT",
  "version": "2.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "astro": "./src/provider.astro",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js"
    },
    "./provider.astro": "./src/provider.astro",
    "./ThemeToggle.astro": "./src/ThemeToggle.astro",
    "./ThemeInspector.astro": "./src/ThemeInspector.astro",
    "./ThemeScrollbar.astro": "./src/ThemeScrollbar.astro",
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    }
  },
  "files": [
    "dist",
    "src/provider.astro",
    "src/ThemeToggle.astro",
    "src/ThemeInspector.astro",
    "src/ThemeScrollbar.astro",
    "src/integration.ts",
    "src/controller.ts",
    "src/attributes.ts",
    "src/transport.ts",
    "src/runtime.ts",
    "src/navigation-script.ts",
    "src/server.ts",
    "src/client.tsx",
    "src/fingerprint.ts",
    "src/blocking-script.ts",
    "src/persistence.ts",
    "src/shared-runtime.ts",
    "src/hooks.ts",
    "src/theme-scope.tsx"
  ],
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json",
    "test": "vitest"
  },
  "peerDependencies": {
    "astro": "^5.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "dependencies": {
    "@theme-kit/core": "workspace:^",
    "@theme-kit/web": "workspace:^"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "astro": "^5.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "description": "Astro integration for Theme Kit.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/themekit-dev/theme-kit.git"
  },
  "homepage": "https://theme-kit-dev.vercel.app",
  "bugs": {
    "url": "https://github.com/themekit-dev/theme-kit/issues"
  },
  "keywords": [
    "theme",
    "astro",
    "theming",
    "dark-mode"
  ],
  "publishConfig": {
    "access": "public"
  }
}
